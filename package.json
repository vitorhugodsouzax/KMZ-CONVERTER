{
  "name": "cobertura-kml-xlsx",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node --watch dist/server.js",
    "build": "tsc && tsc -p tsconfig.web.json && esbuild web/app.ts --bundle --target=es2022 --outfile=public/app.js",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.0.0",
    "fastify": "^5.0.0",
    "fflate": "^0.8.2",
    "he": "^1.2.0"
  },
  "overrides": { "exceljs": { "uuid": "^11.1.1" } },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
